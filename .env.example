# --- SignalWire endpoint protection (read by @signalwire/sdk) ---
# Fixed credentials for the SWML URL. Put the same values in the SignalWire
# dashboard URL: https://USER:PASSWORD@your-domain/
SWML_BASIC_AUTH_USER=sigmail
SWML_BASIC_AUTH_PASSWORD=change-me-to-a-long-random-string
# Public HTTPS base URL that SignalWire reaches this server on (your ngrok domain).
# The SDK uses it to build the tool webhook URLs inside the SWML.
SWML_PROXY_URL_BASE=jaws-opulently-vessel.ngrok-free.dev
# Optional but recommended: your Space's Signing Key (Dashboard > API). When set,
# requests without a valid SignalWire signature are rejected. Needs SWML_PROXY_URL_BASE.
SIGNALWIRE_SIGNING_KEY=

# --- Server ---
PORT=3000

# --- Caller authorization ---
# Comma-separated E.164 numbers (leading +, country code) or SIP addresses
# (user@your-space.sip.signalwire.com) allowed to reach the agent.
ALLOWED_CALLERS=+15551234567
# 4-8 digit PIN the caller must say before any email is read.
CALLER_PIN=482913

# --- Agent ---
# IANA time zone used when the agent says "today at 3:15 PM".
TIMEZONE=America/Los_Angeles
# SignalWire TTS voice.
AGENT_VOICE=inworld.Ashley

# --- Gmail (see README: Google Cloud setup) ---
GMAIL_CREDENTIALS_PATH=secrets/credentials.json
GMAIL_TOKEN_PATH=secrets/token.json
